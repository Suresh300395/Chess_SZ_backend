PORT=3003
MONGO_URI=mongodb://localhost:27017/Chess_SZ
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173

# Application Branding
APP_NAME="National Sports Championship Portal"

# Cryptographic HMAC secret for OTP and Reset Token hashing (Store securely, 32+ characters)
OTP_HMAC_SECRET=your_cryptographically_secure_hmac_secret_here

# Development log flag (Set to false or omit in production)
LOG_OTP_FOR_DEV=false

# SMTP Email Configuration (Nodemailer or direct SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="National Sports Portal <noreply@sports-tournament.org>"

# Optional Third-party Email Provider (e.g. Resend)
RESEND_API_KEY=

# Optional SMS Providers Configuration (Twilio / Fast2SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=

